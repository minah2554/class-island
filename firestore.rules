rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && get(/databases/$(database)/documents/config/teacher).data.uid == request.auth.uid;
    }

    // 학생 계정 이메일: y{학년도}-s{학번}-r{리셋 횟수}@chongchong.example
    function myNo() {
      return request.auth.token.email.split('@')[0].split('-')[1].replace('s', '');
    }
    function mine(year) {
      return get(/databases/$(database)/documents/years/$(year)/students/$(myNo())).data;
    }
    // 그 학년도 명단에 등록을 마친 학생 (비밀번호 리셋되면 uid가 지워져 자동으로 빠진다)
    function isMember(year) {
      return request.auth != null
        && request.auth.token.email.matches('y' + year + '-s[0-9]{4}-r[0-9]+@chongchong[.]example')
        && mine(year).get('uid', '') == request.auth.uid;
    }
    function hasRole(year, role) {
      return isMember(year) && role in mine(year).get('roles', []);
    }
    function isManager(year) {
      return isMember(year) && mine(year).get('roles', []).size() > 0;
    }

    // 교사 계정 등록: 아직 없을 때 딱 한 번만 만들 수 있고, 이후에는 아무도 바꿀 수 없다.
    // 학년도 목록: 로그인 화면에서 읽어야 하므로 누구나 읽고, 추가는 선생님만
    match /config/years {
      allow get: if true;
      allow write: if isTeacher();
    }

    match /config/teacher {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // 로그인 전에 필요한 정보: 학번 → 리셋 횟수 (이름은 없다)
    match /loginIndex/{year} {
      allow get: if true;
      allow write: if isTeacher();
    }

    match /years/{year} {
      allow read: if isTeacher() || isMember(year);
      allow write: if isTeacher();

      match /students/{no} {
        function ownAccount() {
          return request.auth != null && request.auth.token.email
            == 'y' + year + '-s' + no + '-r' + string(resource.data.get('resetCount', 0)) + '@chongchong.example';
        }
        allow read: if isTeacher() || isMember(year);
        allow write: if isTeacher();
        // 본인 문서는 등록 전에도 읽을 수 있다(이름 확인용)
        allow get: if ownAccount();
        // 여권: 본인이 캐릭터·섬 이름·말버릇만 바꿀 수 있다
        allow update: if isMember(year) && no == myNo()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['character', 'islandName', 'catchphrase', 'greeting'])
          && request.resource.data.get('character', 1) in [1, 2, 3, 4, 5, 6, 7, 8]
          && request.resource.data.get('islandName', '').size() <= 12
          && request.resource.data.get('catchphrase', '').size() <= 8
          && request.resource.data.get('greeting', '').size() <= 30;
        // 섬 등록: 비어 있는 uid 칸에 자기 uid만 넣을 수 있다
        allow update: if ownAccount()
          && !('uid' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid;
      }

      // 담당자실 비밀번호: 본인이 처음 한 번 정하고, 바꾸는 것은 선생님만
      match /managerPins/{no} {
        allow read, write: if isTeacher();
        allow get, create: if isMember(year) && no == myNo();
      }

      // 담당자는 새 기록을 추가만 할 수 있다. 수정·삭제는 선생님만.
      match /tardies/{id} {
        allow read: if isTeacher() || isManager(year) || (isMember(year) && resource.data.no == myNo());
        allow write: if isTeacher();
        allow create: if hasRole(year, 'tardy') && request.resource.data.by == myNo();
      }
      match /penalties/{id} {
        allow read: if isTeacher() || isManager(year) || (isMember(year) && resource.data.no == myNo());
        allow write: if isTeacher();
        allow create: if hasRole(year, 'tardy') && request.resource.data.by == myNo();
      }

      // 청소면제권: 담당자는 자기 장부(m)만 쓴다.
      // shortcut: 한 문서에 m과 t가 같이 있어 담당자가 선생님 값(t)을 읽을 수는 있다(화면에는 안 보임).
      // 완전히 숨겨야 하면 문서를 둘로 나눈다.
      match /tickets/{no} {
        allow read: if isTeacher() || isManager(year) || (isMember(year) && no == myNo());
        allow write: if isTeacher();
        allow create: if hasRole(year, 'tickets') && request.resource.data.keys().hasOnly(['m']);
        allow update: if hasRole(year, 'tickets')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['m']);
      }
      match /ticketLog/{id} {
        allow read: if isTeacher() || isManager(year) || (isMember(year) && resource.data.no == myNo());
        allow write: if isTeacher();
        allow create: if hasRole(year, 'tickets') && request.resource.data.by == myNo();
      }

      // 독서기록장: 담당자는 아직 저장되지 않은 날짜만 새로 저장할 수 있다.
      match /reading/{month} {
        allow read: if isTeacher() || isManager(year);
        allow write: if isTeacher();
        allow create: if hasRole(year, 'reading') && request.resource.data.keys().hasOnly(['days']);
        allow update: if hasRole(year, 'reading')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['days'])
          && request.resource.data.days.diff(resource.data.get('days', {})).affectedKeys()
             == request.resource.data.days.diff(resource.data.get('days', {})).addedKeys();
      }

      // 도감 기록: 반 전체가 읽고(누가 잡았는지), 각자 자기 문서에만 쓴다.
      // shortcut: 횟수·결과는 브라우저가 계산해서 마음먹고 조작하는 학생은 막지 못한다. 막으려면 Cloud Functions(유료 요금제)가 필요하다.
      match /collections/{no} {
        allow read: if isTeacher() || isMember(year);
        allow write: if isTeacher();
        allow create, update: if isMember(year) && no == myNo();
      }
      // 날짜별 "반 전원 독서 제출" 표시(채집 보너스)
      match /daily/{date} {
        allow read: if isTeacher() || isMember(year);
        allow write: if isTeacher() || hasRole(year, 'reading');
      }

      // 섬 선물 기록: 반 모두가 읽고(친구 섬에서도 보인다), 선생님과 독서·면제권 담당이 쓴다
      match /gifts/{no} {
        allow read: if isTeacher() || isMember(year);
        allow write: if isTeacher() || hasRole(year, 'reading') || hasRole(year, 'tickets');
      }

      // 학생별 독서기록 사본(내 집에서 본인 것만 읽는다)
      match /stats/{no} {
        allow read: if isTeacher() || (isMember(year) && no == myNo());
        allow write: if isTeacher() || hasRole(year, 'reading');
      }

      // 편지: 보낸 사람·받는 사람·선생님만 읽는다. 지우는 것은 선생님만.
      match /letters/{id} {
        allow read: if isTeacher() || (isMember(year) && (resource.data.from == myNo() || resource.data.to == myNo()));
        allow write: if isTeacher();
        allow create: if isMember(year) && request.resource.data.from == myNo()
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300;
      }
      // 민원: 이름은 선생님과 낸 본인만 볼 수 있다
      match /complaints/{id} {
        allow read: if isTeacher() || (isMember(year) && resource.data.from == myNo());
        allow write: if isTeacher();
        allow create: if isMember(year) && request.resource.data.from == myNo()
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300;
        // 선생님이 확인(seen)하거나 답변(reply)하기 전에는 낸 본인이 글만 고치거나 취소할 수 있다
        allow update: if isMember(year) && resource.data.from == myNo()
          && resource.data.get('seen', false) == false && resource.data.get('reply', '') == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300;
        allow delete: if isMember(year) && resource.data.from == myNo()
          && resource.data.get('seen', false) == false && resource.data.get('reply', '') == '';
      }
      match /notices/{id} {
        allow read: if isTeacher() || isMember(year);
        allow write: if isTeacher();
      }
      match /guestbook/{id} {
        allow read: if isTeacher() || isMember(year);
        allow write: if isTeacher();
        allow create: if isMember(year) && request.resource.data.from == myNo()
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 100;
      }
      // 광장 꾸미기: 산 물건 표시만 학생이 바꿀 수 있다
      match /plaza/{id} {
        allow read: if isTeacher() || isMember(year);
        allow write: if isTeacher();
        allow create, update: if isMember(year) && request.resource.data.keys().hasOnly(['bought']);
      }

      match /corrections/{id} {
        allow read, write: if isTeacher();
        allow create: if isManager(year) && request.resource.data.by == myNo();
        // 자기가 보낸 요청의 처리 결과는 볼 수 있다
        allow read: if isManager(year) && resource.data.by == myNo();
      }
    }
  }
}
